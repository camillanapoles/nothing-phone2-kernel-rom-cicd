# Evolution X Pong Pack Configuration
# GKI-compliant kernel configuration for Nothing Phone 2 (pong)
# This file should be merged with gki_defconfig during kernel build

# ==============================================================================
# GKI Base Requirements (inherited from gki_defconfig)
# ==============================================================================

# IPC and namespaces support (required for DroidSpaces containerization)
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y

# Cgroups for container resource management
CONFIG_CGROUPS=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y

# Security
CONFIG_SECCOMP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y

# Debug
CONFIG_DEBUG_FS=y
CONFIG_DEBUG_KERNEL=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# ==============================================================================
# KernelSU-Next Integration (KernelSU v3.4.2-next)
# ==============================================================================

CONFIG_KSU=y
CONFIG_KPM=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y

# KernelSU features
CONFIG_KSU_FORCE_BUSYBOX=y
CONFIG_KSU_SUPPORT_INIT_RC=y

# ==============================================================================
# SUSFS Integration (SUSFS v4.x for KernelSU)
# ==============================================================================

CONFIG_SUSFS=y
CONFIG_SUSFS_KSU=y

# ==============================================================================
# DroidSpaces kABI Patches
# ==============================================================================

# SYSVIPC patch for GKI below 6.12 (applied via 001 patch)
# POSIX mqueue ABI padding (applied via 002 patch)
# These patches are applied separately in CI - configs enabled in base GKI

# ==============================================================================
# Network Configuration
# ==============================================================================

NETFILTER=y
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_NETFILTER_XT_TARGET_TPROXY=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_ACT_BPF=y

# ==============================================================================
# CPU Governor and Thermal
# ==============================================================================

CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_THERMAL=y
CONFIG_THERMAL_HWMON=y
CONFIG_THERMAL_OF=y

# ==============================================================================
# DMA and Shared Buffer
# ==============================================================================

CONFIG_DMA_SHARED_BUFFER=y

# ==============================================================================
# Device-Specific (Nothing Phone 2)
# ==============================================================================

# Camera support (LTP tests require camera)
CONFIG_VIDEO_DEV=y
CONFIG_VIDEO_V4L2=y
CONFIG_VIDEOBUF2_CORE=y
CONFIG_VIDEOBUF2_V4L2=y
CONFIG_VIDEOBUF2_MEMOPS=y
CONFIG_VIDEOBUF2_DMA_CONTIG=y
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_PANEL=y
CONFIG_DRM_BRIDGE=y

# Audio
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_APQ8016_SND=y

# WiFi and Bluetooth
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y

# Display
CONFIG_DRM_MSM=y
CONFIG_DRM_PANEL_SIMPLE=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# Storage
CONFIG_FS_EXT4=y
CONFIG_SQUASHFS=y
CONFIG_FUSE_FS=y

# ==============================================================================
# Build Options
# ==============================================================================

# LTO for size optimization
CONFIG_LTO_THIN=y

# Compiler options
CONFIG_CC_OPTIMIZATIONS_FOR_PERFORMANCE=y

# Strip debug symbols for size
CONFIG_STRIP_NONE=y

# ==============================================================================
# AnyKernel3 Packaging Support
# ==============================================================================

# Required by AnyKernel3 for ROM installation
CONFIG_ARM64_MODULE_UNLOAD=y
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_SHA256=y

# End of evox_pong_pack.config